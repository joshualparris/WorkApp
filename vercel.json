{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/jobs/refresh.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/jobs/refresh",
      "schedule": "0 21 * * *"
    },
    {
      "path": "/api/jobs/refresh",
      "schedule": "30 2 * * *"
    }
  ]
}
